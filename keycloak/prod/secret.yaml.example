# Template only — never commit real values. The live secret already exists in
# cdip-auth; to recreate it from scratch:
#
#   kubectl --context cdip-prod -n cdip-auth create secret generic keycloak-credentials \
#     --from-literal=KEYCLOAK_USER='<master admin user>' \
#     --from-literal=KEYCLOAK_PASSWORD='<master admin password>' \
#     --from-literal=DB_USER='<keycloak db user>' \
#     --from-literal=DB_PASSWORD='<keycloak db password>'
#
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-credentials
  namespace: cdip-auth
type: Opaque
stringData:
  KEYCLOAK_USER: CHANGE_ME
  KEYCLOAK_PASSWORD: CHANGE_ME
  DB_USER: CHANGE_ME
  DB_PASSWORD: CHANGE_ME
